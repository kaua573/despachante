+
+@bp.route("/api/relatorios/clientes/<int:cid>/escopo")
+@login_required
+@requer_permissao("gerar_relatorios")
+def api_escopo_cliente(cid):
+    """Proprietários e veículos do cliente, para o usuário escolher o que incluir."""
