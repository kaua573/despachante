+// ── Busca global (cliente por nome/CPF/CNPJ, veículo por placa) ─────────────
+let _buscaGlobalTimer = null;
+let _buscaGlobalAbort = null;
+
+function buscaGlobalDigitou() {
+  const termo = document.getElementById('input-busca-global').value.trim();
+  clearTimeout(_buscaGlobalTimer);
+  if (termo.length < 2) {
+    document.getElementById('painel-busca-global').classList.remove('aberto');
+    return;
+  }
+  _buscaGlobalTimer = setTimeout(() => _executarBuscaGlobal(termo), 250);
+}
+
+function buscaGlobalFoco() {
+  const painel = document.getElementById('painel-busca-global');
+  if (painel.innerHTML.trim()) painel.classList.add('aberto');
+}
+
+async function _executarBuscaGlobal(termo) {
+  if (_buscaGlobalAbort) _buscaGlobalAbort.abort();
+  _buscaGlobalAbort = new AbortController();
+
+  const painel = document.getElementById('painel-busca-global');
+  painel.innerHTML = '<p class="sem-notificacoes">Buscando...</p>';
+  painel.classList.add('aberto');
+
+  let dados;
+  try {
+    const resp = await fetch(`/api/busca-global?q=${encodeURIComponent(termo)}`, { signal: _buscaGlobalAbort.signal });
+    if (!resp.ok) throw new Error();
+    dados = await resp.json();
+  } catch (e) {
+    if (e.name === 'AbortError') return;
+    painel.innerHTML = '<p class="sem-notificacoes">Erro ao buscar.</p>';
+    return;
+  }
+
+  const clientes = dados.clientes || [];
+  const veiculos = dados.veiculos || [];
+
+  if (!clientes.length && !veiculos.length) {
+    painel.innerHTML = '<p class="sem-notificacoes">Nada encontrado.</p>';
+    return;
+  }
+
+  let html = '';
+  if (clientes.length) {
+    html += '<div class="painel-notificacoes-header" style="border-bottom:none;padding-bottom:4px;">Clientes</div>';
+    html += clientes.map(c => `<a class="item-notificacao" href="/clientes/${c.id}/veiculos">
+      <div class="in-topo"><span>${escapeHtml(c.nome)}</span></div>
+      <div class="in-sub">${escapeHtml(c.documento || '')}</div>
+    </a>`).join('');
+  }
+  if (veiculos.length) {
+    html += '<div class="painel-notificacoes-header" style="border-bottom:none;padding-bottom:4px;">Veículos</div>';
+    html += veiculos.map(v => `<a class="item-notificacao" href="/clientes/${v.cliente_id}/veiculos">
+      <div class="in-topo"><span class="in-placa">${escapeHtml(v.placa)}</span></div>
+      <div class="in-sub">${escapeHtml(v.cliente_nome)}</div>
+    </a>`).join('');
+  }
+  painel.innerHTML = html;
+  painel.classList.add('aberto');
+}
+
+document.addEventListener('keydown', (ev) => {
+  const campo = document.getElementById('input-busca-global');
+  if (!campo) return;
+  if (ev.key === '/' && document.activeElement !== campo
+      && !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) {
+    ev.preventDefault();
+    campo.focus();
+  }
+  if (ev.key === 'Escape' && document.activeElement === campo) {
+    campo.blur();
+    document.getElementById('painel-busca-global').classList.remove('aberto');
+  }
+});
+
 // Notificação nativa do Windows/SO. Só dispara se a pessoa já autorizou
 // antes — na primeira vez só pede permissão silenciosamente, sem
 // interromper nada; da próxima vez que houver pendência já aparece.
