       <a href="/relatorios" class="{{ 'ativa' if '/relatorios' in request.path else '' }}">{{ icon('file') }} Relatórios</a>
     {% endif %}
diff --git a/app/templates/pendencias_geral.html b/app/templates/pendencias_geral.html
new file mode 100644
