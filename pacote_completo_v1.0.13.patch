+  atualizar: '<span class="badge badge-pendente">Atualizar</span>',
+  erro:      '<span class="badge badge-vencido">Erro</span>',
+};
+
+async function iniciarImportacaoComPreview(input, urlPreview, urlConfirmar) {
+  const arquivo = input.files[0];
+  if (!arquivo) return;
+
+  _arquivoImportacaoPendente = arquivo;
+  _urlConfirmarImportacaoPendente = urlConfirmar;
+
+  const formData = new FormData();
+  formData.append('arquivo', arquivo);
+
+  const preview = await apiFetch(urlPreview, { method: 'POST', body: formData });
+  input.value = '';   // permite selecionar o mesmo arquivo de novo, se precisar
+  if (!preview) { _arquivoImportacaoPendente = null; return; }
+
+  document.getElementById('preview-resumo').textContent =
+    `${preview.contagem.criar} novo(s), ${preview.contagem.atualizar} atualizado(s), ${preview.contagem.erro} com erro.`;
+
+  document.getElementById('preview-lista').innerHTML = preview.itens.map(item => `
+    <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;padding:6px 0;border-bottom:1px solid var(--cinza2);font-size:12px;">
+      <span>Linha ${escapeHtml(item.linha)}: ${escapeHtml(item.resumo || item.erro || '')}</span>
+      ${BADGE_ACAO_IMPORTACAO[item.acao] || ''}
+    </div>`).join('') || '<p style="font-size:12px;color:var(--sub);">Planilha vazia — nada para importar.</p>';
+
+  document.getElementById('btn-confirmar-importacao').disabled =
+    (preview.contagem.criar + preview.contagem.atualizar) === 0;
+
+  document.getElementById('modal-preview-importacao').classList.add('open');
+}
+
+function fecharPreviewImportacao() {
+  document.getElementById('modal-preview-importacao').classList.remove('open');
+  _arquivoImportacaoPendente = null;
+  _urlConfirmarImportacaoPendente = null;
+}
+
+async function confirmarImportacao() {
+  if (!_arquivoImportacaoPendente || !_urlConfirmarImportacaoPendente) return;
+
+  const formData = new FormData();
+  formData.append('arquivo', _arquivoImportacaoPendente);
+
+  const resultado = await apiFetch(_urlConfirmarImportacaoPendente, { method: 'POST', body: formData });
+  fecharPreviewImportacao();
+  if (!resultado) return;
+
+  if (typeof window.onImportacaoConcluida === 'function') {
+    window.onImportacaoConcluida(resultado);
+  }
+}
+
+document.addEventListener('keydown', (ev) => {
+  if (ev.key === 'Escape' && document.getElementById('modal-preview-importacao').classList.contains('open')) {
+    fecharPreviewImportacao();
+  }
+});
 </script>
 {% block scripts %}{% endblock %}
 </body>
